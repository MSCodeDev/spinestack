# Directory for the database and cover images
DATA_DIR=./data

# Public URL you open the app at. Its protocol (http or https) is used for form security checks.
# Behind a reverse proxy you can set PROTOCOL_HEADER=x-forwarded-proto and
# HOST_HEADER=x-forwarded-host instead.
ORIGIN=http://localhost:5173

# Required. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Optional: enables Google Books lookups (Google rejects requests without a key)
GOOGLE_BOOKS_API_KEY=""
